{
  "name": "realtime-translator-interview-assistant",
  "version": "0.1.0",
  "description": "Real-time Translator & Interview Assistant — Electron desktop app powered by Soniox (STT + translation) and OpenAI (interview answer generation).",
  "main": "dist-electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && vite build && electron-builder --win --x64 --dir",
    "build:exe": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && vite build && electron-builder --win --x64",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "fast-levenshtein": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
